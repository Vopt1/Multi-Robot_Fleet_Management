<?xml version="1.0" encoding="utf-8"?>


<robot name="differential_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="body_x" value="0.4" />
    <xacro:property name="body_y" value="0.3" />
    <xacro:property name="body_z" value="0.15" />
    <xacro:property name="body_mass" value="2.0" />
    <xacro:property name="wheel_r" value="0.05" />
    <xacro:property name="wheel_l" value="0.05" />

    <xacro:macro name="wheel" params="name x y z">
        <link name="${name}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_r}" length="${wheel_l}" />
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1" />
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_r}" length="${wheel_l}" />
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <mass value="0.2" />
                <inertia ixx="${0.2 * (3 * wheel_r * wheel_r + wheel_l * wheel_l) / 12}" ixy="0" ixz="0"
                         iyy="${0.2 * (3 * wheel_r * wheel_r + wheel_l * wheel_l) / 12}" iyz="0"
                         izz="${0.2 * 0.5 * wheel_r * wheel_r}" />
            </inertial>
        </link>
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="body" />
            <child link="${name}_wheel" />
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>

    <link name="base_link" />

    <link name="body">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${body_x} ${body_y} ${body_z}" />
            </geometry>
            <material name="solid_white">
                <color rgba="0.3 0.1 0.4 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${body_x} ${body_y} ${body_z}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="${body_mass}" />
            <origin xyz="0 0 0" />
            <inertia ixx="${body_mass * (body_z * body_z + body_y * body_y) / 12}" 
                ixy="0.0" ixz="0.0" iyy="${body_mass * (body_z * body_z + body_x * body_x) / 12}" iyz="0.0" 
                izz="${body_mass * (body_x * body_x + body_y * body_y) / 12}" />
        </inertial>
    </link>
    <joint name="base_link_to_body" type="fixed">
        <parent link="base_link" />
        <child link="body" />
        <origin xyz="0 0 ${body_z/2 + wheel_r}" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <limit lower="-1.0" upper="1.0" effort="100" velocity="100" />
    </joint>

    <xacro:wheel name="back_right" x="-0.15" y="0.175" z="-0.075" />
    <xacro:wheel name="back_left" x="-0.15" y="-0.175" z="-0.075" />

    <link name="caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${wheel_r}" />
            </geometry>
            <material name="material_name">
                <color rgba="0.8 0.8 0.8 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${wheel_r}" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1" />
            <origin xyz="0 0 0" />
            <inertia ixx="${2 * 0.1 * wheel_r * wheel_r /5}" ixy="0.0" ixz="0.0" 
                     iyy="${2 * 0.1 * wheel_r * wheel_r /5}" iyz="0.0" 
                     izz="${2 * 0.1 * wheel_r * wheel_r /5}" />
        </inertial>
    </link>
    <joint name="caster_wheek_to_base" type="continuous">
        <parent link="body" />
        <child link="caster_wheel" />
        <origin xyz="0.15 0 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>


    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="lidar_color">
                <color rgba="0.1 0.5 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <!-- Inertial values are required by Gazebo to render physics properly -->
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="7.5833e-5" ixy="0" ixz="0" 
                     iyy="7.5833e-5" iyz="0" 
                     izz="1.25e-4"/>
        </inertial>
    </link>
    <joint name="laser_to_body" type="fixed">
        <parent link="body" />
        <child link="laser_frame" />
        <origin xyz="0 0 0.1" rpy="0 0 0" />
    </joint>

</robot>
